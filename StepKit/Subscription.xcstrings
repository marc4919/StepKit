    "paywall.usage.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished Kits don't count. AI uses renew every month."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los Kits terminados no cuentan. Los usos de IA se renuevan cada mes."
          }
