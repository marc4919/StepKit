{
  "sourceLanguage": "en",
  "strings": {
    "paywall.close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar"
          }
        }
      }
    },
    "paywall.header.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go further with your Kits"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llega más lejos con tus Kits"
          }
        }
      }
    },
    "paywall.header.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The essentials are free forever. Pro removes the limits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo esencial es gratis para siempre. Pro quita los límites."
          }
        }
      }
    },
    "paywall.header.pro.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have StepKit Pro"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes StepKit Pro"
          }
        }
      }
    },
    "paywall.header.pro.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No limits on Kits or AI. Thanks for supporting StepKit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin límites de Kits ni de IA. Gracias por apoyar StepKit."
          }
        }
      }
    },
    "paywall.header.pro.renews %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renews on %@. Thanks for supporting StepKit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva el %@. Gracias por apoyar StepKit."
          }
        }
      }
    },
    "paywall.limit.kits.title %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have %@ active Kits"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya tienes %@ Kits activos"
          }
        }
      }
    },
    "paywall.limit.kits.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish or delete one to start another, or go Pro to have as many as you want."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina o borra uno para empezar otro, o pásate a Pro para tener todos los que quieras."
          }
        }
      }
    },
    "paywall.limit.ai.title %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've used your %@ AI uses this month"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has usado tus %@ usos de IA de este mes"
          }
        }
      }
    },
    "paywall.limit.ai.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They renew next month. Meanwhile, the assistant answers on your device. With Pro there's no monthly cap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renuevan el mes que viene. Mientras tanto, el asistente responde desde tu dispositivo. Con Pro no hay cupo mensual."
          }
        }
      }
    },
    "paywall.usage.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
